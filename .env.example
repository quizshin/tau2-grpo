# Copy to code/.env and chmod 600 code/.env. Never commit credentials.
SWANLAB_API_KEY=
# TAU3 prefix avoids SwanLab 0.10 nested Settings.project parsing collision.
TAU3_SWANLAB_PROJECT=tau3-grpo-pytrio
SWANLAB_MODE=online
# SWANLAB_WORKSPACE=your-team
# SWANLAB_LOG_DIR=/root/autodl-fs/tau3_grpo_fix/results/swanlog

# Optional storage roots. Defaults: code/{data,models,results,.cache}.
# TAU3_DATA_ROOT=/root/autodl-tmp/tau3/data
# TAU3_MODEL_ROOT=/root/autodl-tmp/tau3/models
# TAU3_RUN_ROOT=/root/autodl-tmp/tau3/runs
# TAU3_CACHE_ROOT=/root/autodl-tmp/tau3/cache
